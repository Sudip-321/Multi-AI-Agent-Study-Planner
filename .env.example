# LLM providers (optional — the app works fully offline with deterministic agents)
# Get a key at https://platform.openai.com/api-keys or https://console.anthropic.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use when keys are present: openai | anthropic (default: openai)
LLM_PROVIDER=openai

# Model override (optional)
LLM_MODEL=
